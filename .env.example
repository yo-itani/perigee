# MariaDB
PERIGEE_DB_ROOT_PASSWORD=rootpassword
PERIGEE_DB_HOST=mariadb
PERIGEE_DB_PORT=3306
PERIGEE_DB_USER=perigee
PERIGEE_DB_PASSWORD=perigee
PERIGEE_DB_NAME=perigee

# Application
PERIGEE_DEBUG=true

# JWT / Auth
PERIGEE_JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32chars
PERIGEE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PERIGEE_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
PERIGEE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Slack
PERIGEE_SLACK_WEBHOOK_URL=
PERIGEE_SLACK_ENABLED=true
PERIGEE_SLACK_HTTP_TIMEOUT=10
